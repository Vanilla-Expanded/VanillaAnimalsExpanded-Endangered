<?xml version="1.0" encoding="utf-8" ?>
<Patch>
	<!-- Black-footed ferret -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="AEXP_BlackFootedFerret"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.ExtendedRaceProperties">
				<bodyClock>Nocturnal</bodyClock>
			</li>
		</value>
	</Operation>
	<!-- Panda -->
	<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Odyssey</li>
		</mods>
		<nomatch Class="PatchOperationAddModExtension">
			<xpath>/Defs/ThingDef[defName="AEXP_Panda"]</xpath>
			<value>
				<li Class="VEF.AnimalBehaviours.ExtendedRaceProperties">
					<bodyClock>Crepuscular</bodyClock>
				</li>
			</value>
		</nomatch>
	</Operation>
	
	<!-- Thylacine -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="AEXP_Thylacine"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.ExtendedRaceProperties">
				<bodyClock>Nocturnal</bodyClock>
			</li>
		</value>
	</Operation>
	<!-- Pangolin -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="AEXP_Pangolin"]</xpath>
		<value>
			<li Class="VEF.AnimalBehaviours.ExtendedRaceProperties">
				<bodyClock>Nocturnal</bodyClock>
			</li>
		</value>
	</Operation>
</Patch>